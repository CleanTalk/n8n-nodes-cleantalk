{
	"name": "n8n-nodes-cleantalk",
	"version": "0.1.1",
	"description": "n8n community node for CleanTalk Anti-Spam: check form submissions, comments and registrations for spam, and look up emails and IPs in the CleanTalk blacklist database",
	"license": "MIT",
	"homepage": "https://github.com/CleanTalk/n8n-nodes-cleantalk",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"cleantalk",
		"anti-spam",
		"antispam",
		"spam",
		"spam filter",
		"spam protection",
		"captcha alternative",
		"lead validation",
		"form spam",
		"email validation",
		"bot detection"
	],
	"author": {
		"name": "CleanTalk",
		"email": "plugins@cleantalk.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/CleanTalk/n8n-nodes-cleantalk.git"
	},
	"bugs": {
		"url": "https://github.com/CleanTalk/n8n-nodes-cleantalk/issues"
	},
	"engines": {
		"node": ">=20.15"
	},
	"scripts": {
		"build": "n8n-node build",
		"build:watch": "tsc --watch",
		"dev": "n8n-node dev",
		"lint": "n8n-node lint",
		"lint:fix": "n8n-node lint --fix",
		"release": "n8n-node release",
		"prepublishOnly": "n8n-node prerelease"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public"
	},
	"n8n": {
		"n8nNodesApiVersion": 1,
		"strict": true,
		"credentials": [
			"dist/credentials/CleanTalkApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/CleanTalk/CleanTalk.node.js"
		]
	},
	"devDependencies": {
		"@n8n/node-cli": "^0.56.4",
		"eslint": "10.15.0",
		"n8n-workflow": "*",
		"prettier": "3.8.3",
		"release-it": "20.2.0",
		"typescript": "5.9.3"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	}
}
